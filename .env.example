# ==============================================================================
# Drex Decision Gateway Environment Configuration (.env.example)
#
# Copy this file to .env and configure as needed.
# All settings have safe local defaults.
# ==============================================================================

# Provider Mode: LIVE or REPLAY
# In REPLAY mode, the gateway operates completely offline with zero credentials.
# In LIVE mode, requests are sent to the production Drex endpoint.
DREX_PROVIDER_MODE=

# Drex API Credentials (Required for LIVE mode only)
# Format: nace_sk_<43 alphanumeric/hyphen/underscore characters>
# Alternatively, save to ~/.config/drex/api.key with chmod 0600
DREX_API_KEY=

# Optional: Path to custom API key file
DREX_API_KEY_FILE=

# Base URL for Drex API
DREX_BASE_URL=https://drex.nace.ai

# Default Decision Model
# Options: drex-latest (default), drex-v1.5, drex-v1.0
DREX_MODEL=drex-latest

# HTTP Client Timeout (seconds)
DREX_TIMEOUT_SECONDS=60.0

# SQLite Persistence Path
DREX_GATEWAY_DB=drex_gateway.db

# Default Confidence Policies
# Accept threshold: probability required to accept decision without human escalation
DREX_ACCEPT_THRESHOLD=0.85
# Escalation threshold: probability below which task requires escalation
DREX_ESCALATION_THRESHOLD=0.60

# HTTP Server Configuration
DREX_SERVER_HOST=127.0.0.1
DREX_SERVER_PORT=8000

# Telemetry / Prometheus Metrics
DREX_METRICS_ENABLED=true
